aws_region  = "ap-south-1"
environment = "prod"
vpc_cidr    = "10.104.0.0/16"

azs             = ["ap-south-1a", "ap-south-1b"]
private_subnets = ["10.104.88.0/24", "10.104.89.0/24"]
public_subnets  = ["10.104.90.0/25", "10.104.90.128/25"]

ecr_repository_names = [
  "prod-api-gateway",
  "prod-account-service",
  "prod-wallet-service",
  "prod-payment-service",
  "prod-settlement-service",
]

database_name     = "prodmysqldb"
database_username = "admin"

# Replace this with your own fixed public IP. Never use 0.0.0.0/0 for production.
eks_public_access_cidrs = ["65.0.138.49/32"]

common_tags = {
  ManagedBy   = "Terraform"
  Project     = "paywave"
  Environment = "production"
}
